<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.LadyDoctorClinic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/clinic_rose_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/clinic_rose_light</item>
        <item name="colorSecondary">@color/clinic_teal</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.LadyDoctorClinic.Splash" parent="Theme.LadyDoctorClinic">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/clinic_rose_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
